PORT=3001
NODE_ENV=development

# MongoDB (Atlas hoặc local). Trên Atlas nhớ thêm IP của bạn vào Network Access,
# nếu không backend sẽ không kết nối được và web báo lỗi 503.
MONGO_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/mekong_delta?retryWrites=true&w=majority

# JWT Secret - đặt chuỗi dài, ngẫu nhiên
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-ngau-nhien

# Địa chỉ web được phép gọi API (CORS). Nhiều địa chỉ cách nhau bằng dấu phẩy.
# localhost / 127.0.0.1 (mọi cổng) và mạng LAN (khi NODE_ENV=development) luôn được cho phép.
FRONTEND_URL=http://localhost:5073

# ===== SMTP: gửi mã OTP xác thực email khi đăng ký =====
# Gmail đã bật xác minh 2 bước: KHÔNG dùng mật khẩu đăng nhập thường.
# Tạo "Mật khẩu ứng dụng" (App password) 16 ký tự tại https://myaccount.google.com/apppasswords
# rồi dán vào SMTP_PASS (viết liền, không dấu cách).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=Delta Stress Lens <your-email@gmail.com>

# (Không còn dùng) PostgreSQL: số liệu nhập liệu đã chuyển sang MongoDB
# DATABASE_URL=
