# ===== FRONTEND CONFIG (Next.js) =====
# Backend API URL - CRITICAL!
# Local development:
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Production (Vercel):
# NEXT_PUBLIC_BACKEND_URL=https://your-railway-app.railway.app

# ===== BẢN ĐỒ (MapTiler) =====
# Lấy khóa miễn phí tại https://cloud.maptiler.com/account/keys/
# Khóa này nằm trong trình duyệt nên hãy giới hạn "Allowed origins" trên trang MapTiler (thêm http://localhost:5073).
NEXT_PUBLIC_MAPTILER_KEY=
# Kiểu bản đồ (tùy chọn): streets-v2-dark (mặc định), dataviz-dark, basic-v2-dark, backdrop-dark, streets-v2
# NEXT_PUBLIC_MAPTILER_STYLE=streets-v2-dark

# ===== AI - dùng cho Bác Tư Vấn và Phân tích AI =====
# Chỉ cần MỘT trong hai khóa. Nếu có cả hai, mặc định dùng Groq và tự chuyển sang Gemini khi Groq lỗi.
# KHÔNG thêm NEXT_PUBLIC_ phía trước, khóa chỉ nằm ở máy chủ. Viết liền, không dấu ngoặc kép.

# Groq: tạo khóa tại https://console.groq.com/keys
GROQ_API_KEY=
# Tùy chọn: ép dùng một model. Để trống thì thử lần lượt openai/gpt-oss-120b, llama-3.3-70b-versatile, openai/gpt-oss-20b, llama-3.1-8b-instant
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini (tùy chọn): tạo khóa tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Muốn ưu tiên Gemini thay vì Groq khi có cả hai khóa:
# AI_PROVIDER=gemini

# ===== BACKEND CONFIG (Express) =====
# MongoDB Connection
MONGO_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/mekong_delta?retryWrites=true&w=majority

# JWT Secret - Generate a strong secret!
JWT_SECRET=your-super-secret-key-change-this-in-production

# Environment
NODE_ENV=development

# Frontend URL for CORS (backend will accept requests from this origin)
# Local:
# Có thể khai báo nhiều địa chỉ, cách nhau bằng dấu phẩy. localhost và 127.0.0.1 (mọi cổng) luôn được cho phép.
FRONTEND_URL=http://localhost:5073

# Production:
# FRONTEND_URL=https://your-vercel-app.vercel.app

# ===== DEPLOYMENT NOTES =====
# 1. For LOCAL development:
#    - Copy .env.example to .env.local
#    - Fill in actual values
#    - .env.local is in .gitignore (NOT pushed to repo)
#
# 2. For VERCEL deployment:
#    - Set NEXT_PUBLIC_BACKEND_URL in Vercel Environment Variables
#    - Example: https://mekong-production.up.railway.app
#
# 3. For RAILWAY deployment (Backend):
#    - Set MONGO_URI, JWT_SECRET in Railway Environment Variables
#    - Set FRONTEND_URL to your Vercel app URL
#
# 4. CORS Configuration (backend):
#    - Allowed origins: localhost:3000, localhost:5073, production FRONTEND_URL
#    - Change in backend/src/server.ts if adding new frontend URLs
